# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection string. When set, runtime persistence uses PostgreSQL.
# Leave unset only for local JSON development/tests.
DATABASE_URL="postgresql://user:password@localhost:5432/swms?schema=public"

# SWMS Adapters & Configuration (Defaults operate 100% out-of-the-box with fakes/dev mode)
SMS_PROVIDER="console" # Options: console | msg91
MSG91_AUTH_KEY=""

PAYMENTS_PROVIDER="fake" # Options: fake | razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

MAPS_PROVIDER="osm" # Options: osm | google
GOOGLE_MAPS_API_KEY=""

STORAGE_PROVIDER="local" # Options: local | cloudinary
CLOUDINARY_URL=""

PAYMENT_MODE="BOTH" # Options: PAY_NOW | PAY_LATER | BOTH

# ─── Admin API ────────────────────────────────────────────────────────────────
# Admin login email (used with POST /api/admin/auth/login)
ADMIN_EMAIL="admin@swms.local"

# Plaintext password (dev only). In production, set ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD="admin123"

# bcrypt hash of the admin password. When set, ADMIN_PASSWORD is ignored.
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',10).then(console.log)"
ADMIN_PASSWORD_HASH=""

# JWT secret for signing admin tokens. Use a long random string in production.
ADMIN_JWT_SECRET="change-me-in-production-use-long-random-string"
ADMIN_TOKEN_SECRET="change-me-in-production-use-long-random-string"

# CORS origin for the admin frontend (Vite default: http://localhost:5173)
ADMIN_ORIGIN="http://localhost:5173"
